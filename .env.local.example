# Copy to .env.local and fill in real values before deploying.

# Enquiries (contact, booking and newsletter forms) are delivered to BOTH of the destinations
# below when configured. A lead counts as received if at least one of them accepts it.
# In development with neither set, leads are logged to the server console instead.
# In production with neither set, the forms return an error rather than silently dropping leads.

# Resend (https://resend.com) — sends each enquiry to the team inbox.
RESEND_API_KEY=

# Inbox that receives contact/booking leads. Defaults to lib/site.ts's site.email if unset.
CONTACT_TO_EMAIL=info@adventophile.com

# "From" address for outgoing lead emails. Must be a domain verified in Resend once you go live;
# defaults to Resend's shared onboarding@resend.dev sender for testing.
CONTACT_FROM_EMAIL=

# Absolute site URL — used to build canonical URLs, sitemap.xml, robots.txt, and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://www.adventophile.com

# Google Sheet lead log — the URL of the Apps Script web app from scripts/leads-sheet.gs.
# Setup steps: docs/leads-setup.md
LEADS_SHEET_WEBHOOK_URL=
# Shared secret; must match SECRET in the Apps Script. Use a long random string.
LEADS_SHEET_SECRET=
