# Copy to .env.local and fill in real values before deploying.

# Enquiries (contact, booking and newsletter forms) are saved to the Google Sheet configured
# below — see docs/leads-setup.md. In development without it, leads are logged to the server
# console instead; in production without it, the forms return an error rather than dropping leads.

# Absolute site URL — used to build canonical URLs, sitemap.xml, robots.txt, and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://www.adventophile.com

# Google Sheet lead log — the URL of the Apps Script web app from scripts/leads-sheet.gs.
# Setup steps: docs/leads-setup.md
LEADS_SHEET_WEBHOOK_URL=
# Shared secret; must match the LEADS_SHEET_SECRET script property in Apps Script. Use a long random string.
LEADS_SHEET_SECRET=
